# BLING_NFE_NATUREZA_ID=15111278164
# BLING_NFE_ENABLED=true

# Mercado Pago (legado — não usado)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Admin (sessão JWT)
