NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (projeto "iseul")
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proprietário (vê integrações e página Usuários)
OWNER_ADMIN_EMAIL=manu.oficial93@gmail.com

# Asaas (pagamentos — PIX e cartão)
# Chaves Asaas começam com $. Use sem barra invertida: $aact_... (não \$aact_...)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENV=production

# Bling — pedido de venda e NF-e (OAuth v3; tokens renovados no Supabase)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_API_KEY=
BLING_REFRESH_TOKEN=

# Opcional: natureza de operação da NF-e e toggle de emissão
# B2C (CPF / não contribuinte) → CSOSN 102
# BLING_NFE_NATUREZA_B2C=Venda de mercadoria a não contribuinte
# BLING_NFE_NATUREZA_B2C_ID=15111278165
# B2B (CNPJ / contribuinte) → CSOSN 101
# BLING_NFE_NATUREZA_B2B=Venda de mercadoria
# BLING_NFE_NATUREZA_B2B_ID=15111278164
# BLING_NFE_ENABLED=true

# Mercado Pago (legado — não usado)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Admin (sessão JWT)
AUTH_SECRET=

# Opcional: frete grátis e desconto PIX (sobrescreve store_settings)
FREE_SHIPPING_THRESHOLD=199
PIX_DISCOUNT_PERCENT=5

# Melhor Envio (cotação de frete + etiquetas)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REFRESH_TOKEN=
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=79072266
# MELHOR_ENVIO_SANDBOX=true
# MELHOR_ENVIO_USER_AGENT=Iseul (contato@iseul.com.br)

# Seed admin inicial (scripts/seed-admin.mjs) — quando Supabase estiver configurado
ADMIN_EMAIL=manu.oficial93@gmail.com
ADMIN_PASSWORD=123456

# Fallback local (sem Supabase configurado)
DEMO_ADMIN_EMAIL=manu.oficial93@gmail.com
DEMO_ADMIN_PASSWORD=123456
DEMO_ADMIN_NAME=Manu

# Meta Pixel (tráfego pago — Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=

# OpenAI (assistente da loja — em produção só aparece com NEXT_PUBLIC_ISEUL_ASSISTANT=1)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
NEXT_PUBLIC_ISEUL_ASSISTANT=
